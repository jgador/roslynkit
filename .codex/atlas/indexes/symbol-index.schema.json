{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Atlas Symbol Index",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAtUtc",
    "targetPath",
    "toolName",
    "toolPath",
    "documents",
    "skipped"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "targetPath": {
      "type": "string"
    },
    "toolName": {
      "type": "string"
    },
    "toolPath": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "projectName",
          "documentKind",
          "symbolCount",
          "symbols"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "projectName": {
            "type": "string"
          },
          "documentKind": {
            "type": "string"
          },
          "symbolCount": {
            "type": "integer",
            "minimum": 0
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "kind",
                "displayName",
                "line",
                "column",
                "containingType",
                "containingNamespace"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "type": "integer",
                  "minimum": 1
                },
                "containingType": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "containingNamespace": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
