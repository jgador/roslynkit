{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Atlas Project Index",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAtUtc",
    "solutionPath",
    "projects"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "solutionPath": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "category",
          "isTestProject",
          "includedInSolution"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "isTestProject": {
            "type": "boolean"
          },
          "includedInSolution": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
